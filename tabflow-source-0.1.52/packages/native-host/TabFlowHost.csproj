<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TabFlowHost</AssemblyName>
    <RootNamespace>TabFlowHost</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      SelfContained=true bundles the .NET 8 runtime into the binary, so users
      don't have to install .NET separately to run the host. Cost: the
      published TabFlowHost.exe grows from ~170 KB to ~70 MB. Worth it — the
      "user has to install .NET 8 Runtime first" friction kept silently
      breaking the host on machines that didn't have a dev toolchain.
      IncludeNativeLibrariesForSelfExtract keeps everything inside the single
      .exe (no temp directory of native libs at runtime).
    -->
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
